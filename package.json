{
  "name": "jevmail",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --experimental-strip-types src/worker-entry.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && npm run test:ui",
    "test:watch": "vitest",
    "test:core": "node scripts/run-core-tests.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --experimental-strip-types src/db/migrate.ts",
    "test:ui": "vitest run tests/unit/ui/dashboard.test.tsx",
    "preflight": "node --experimental-strip-types scripts/preflight.mjs",
    "prestart": "npm run preflight",
    "preworker": "npm run preflight",
    "probe:prompt-limits": "node scripts/probe-prompt-limits.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.5",
    "googleapis": "^160.0.0",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
