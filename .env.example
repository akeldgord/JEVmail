# Public URL for this JEVmail instance. For local Docker installs, keep both URLs identical.
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Generate distinct random secrets. Do not commit your real .env file.
AUTH_SECRET=replace-with-32-plus-random-characters
APP_ENCRYPTION_KEY=replace-with-32-plus-random-characters

# Google OAuth application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Jev credentials and a pinned production model.
JEVMODEL_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai

# Docker Compose overrides this to /app/data/jevmail.db inside both containers.
DATABASE_PATH=./data/jevmail.db

# Default processing limits. These can also be changed in the web UI.
POLL_INTERVAL_SECONDS=60
MAX_PER_MINUTE=30
MAX_PER_HOUR=300
MAX_PER_DAY=2000
BACKLOG_BATCH_SIZE=25
# DAILY_SPEND_CENTS=
